@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}
<h1>Log in</h1>
<form asp-action="Login" method="post" class="col-md-5">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="ReturnUrl" type="hidden" />
    <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autocomplete="username" /></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
    <button class="btn btn-primary" type="submit">Log in</button>
</form>
<p class="mt-3">Need an account? <a asp-action="Register">Register</a>.</p>

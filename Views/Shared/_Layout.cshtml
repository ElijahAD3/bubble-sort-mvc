<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BubbleSortMvc</title>
    <script src="~/js/appearance.js" asp-append-version="true"></script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BubbleSortMvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Bubble Sort</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Sort" asp-action="Index">Sort values</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Training" asp-action="Index">Train models</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                    <div class="appearance-controls ms-sm-3">
                        <label for="theme-choice" class="visually-hidden">Theme</label>
                        <select id="theme-choice" class="form-select form-select-sm" aria-label="Theme">
                            <option value="system">System theme</option>
                            <option value="light">Light theme</option>
                            <option value="dark">Dark theme</option>
                        </select>
                        <label for="accent-choice" class="visually-hidden">Accent color</label>
                        <select id="accent-choice" class="form-select form-select-sm" aria-label="Accent color">
                            <option value="blue">Blue</option>
                            <option value="purple">Purple</option>
                            <option value="teal">Teal</option>
                        </select>
                        <span id="appearance-status" class="small text-warning" role="status"></span>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            Bubble Sort
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

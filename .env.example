# Copy to .env on the server and keep the file private.
ASPNETCORE_ENVIRONMENT=Production
AI_PROVIDER=Ollama
AI_ENDPOINT=http://ollama:11434
AI_MODEL=llama3.2:1b
# Only set a key for a provider that requires one.
AI_API_KEY=
# Required only when starting the cloudflare profile.
CLOUDFLARE_TUNNEL_TOKEN=
